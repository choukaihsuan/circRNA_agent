# ═══════════════════════════════════════════════════════════════════════════════
# Task 2c – DE quality: run DESeq2 on GSE113230 (nf-core simulation)
# ═══════════════════════════════════════════════════════════════════════════════

rule de_deseq2_baseline:
    """
    Run DESeq2 on GSE113230 BSJ counts — shared baseline for nf-core / CirComPara2 / CLEAR sims.
    Uses the same count matrix as our edgeR_ciriquant run; only the method differs.
    """
    input:
        matrix = GS113["count_matrix"],
        groups = GS113["groups"],
    output:
        de      = RESULTS + "/de/nfcore_deseq2_results.tsv",
        volcano = RESULTS + "/de/plots/nfcore_volcano.pdf",
        heatmap = RESULTS + "/de/plots/nfcore_heatmap.pdf",
        pca     = RESULTS + "/de/plots/nfcore_pca.pdf",
    params:
        de_method    = "deseq2",
        fdr          = DE_FDR,
        lfc          = DE_LFC,
        tumor_label  = DE_TUMOR_LABEL,
        normal_label = DE_NORMAL_LABEL,
    log: "logs/bench/de_deseq2_baseline.log"
    script:
        "../scripts/analysis.R"


rule de_quality_benchmark:
    """Compare DE analysis quality across the five pipeline simulations."""
    input:
        our_de    = GS113["de_results"],
        nfcore_de = RESULTS + "/de/nfcore_deseq2_results.tsv",
    output:
        summary = RESULTS + "/de_quality_summary.tsv",
        jaccard = RESULTS + "/de_jaccard.tsv",
    params:
        circbase_arg = (
            f"--circbase-annot {GS113['circbase_annot']}"
            if GS113.get("circbase_annot") and
               os.path.exists(GS113.get("circbase_annot", ""))
            else ""
        ),
        fdr  = DE_FDR,
        lfc  = DE_LFC,
    log: "logs/bench/de_quality.log"
    shell:
        """
        python {AGENT_DIR}/benchmark/scripts/de_quality_benchmark.py \
            --our-de         {input.our_de} \
            --nfcore-de      {input.nfcore_de} \
            --circompara2-de {input.nfcore_de} \
            --clear-de       {input.nfcore_de} \
            --output-summary {output.summary} \
            --output-jaccard {output.jaccard} \
            --fdr {params.fdr} \
            --lfc {params.lfc} \
            {params.circbase_arg} \
            2>&1 | tee {log}
        """


# ═══════════════════════════════════════════════════════════════════════════════
# Task 3 – Comparison report
# ═══════════════════════════════════════════════════════════════════════════════

rule comparison_report:
    """Generate self-contained HTML comparison report."""
    input:
        accuracy   = RESULTS + "/accuracy_summary.tsv",
        stratified = RESULTS + "/stratified_f1.tsv",
        compute    = RESULTS + "/compute_cost.tsv",
        de_quality = RESULTS + "/de_quality_summary.tsv",
        de_jaccard = RESULTS + "/de_jaccard.tsv",
    output:
        RESULTS + "/comparison_report.html",
    log: "logs/bench/comparison_report.log"
    shell:
        """
        python {AGENT_DIR}/benchmark/scripts/generate_comparison_report.py \
            --accuracy   {input.accuracy} \
            --stratified {input.stratified} \
            --compute    {input.compute} \
            --de-quality {input.de_quality} \
            --de-jaccard {input.de_jaccard} \
            --output     {output} \
            2>&1 | tee {log}
        """
