"""
Benchmark Snakefile – circRNA pipeline comparison
==================================================
比較 our pipeline vs. nf-core/circrna vs. circRNA-sponging

前提條件：
  1. GSE113230 的 edgeR_ciriquant DE results 已由主 pipeline 產生
     （config gse113230.de_results）
  2. conda env ciriquant 已啟動
  （GSE55872 下載與 trim 已整合進本 Snakefile，無需手動準備）

執行方式（從 circRNA_agent/ 根目錄執行）：
  conda activate ciriquant
  snakemake \\
      --snakefile benchmark/Snakefile \\
      --configfile benchmark/config_benchmark.yaml \\
      --cores 8 \\
      --resources mem_gb=60 \\
      --keep-going \\
      --rerun-incomplete

只跑 accuracy benchmark（跳過 DE quality，適合 GSE113230 未完成的情況）：
  snakemake \\
      --snakefile benchmark/Snakefile \\
      --configfile benchmark/config_benchmark.yaml \\
      --cores 8 \\
      --until accuracy_benchmark \\
      compute_cost
"""

import os

configfile: "benchmark/config_benchmark.yaml"

shell.executable("bash")

# ─── Config aliases ───────────────────────────────────────────────────────────
GS55   = config["gse55872"]
GS113  = config["gse113230"]
BENCH  = config["benchmark"]
GENOME = config["genome"]

TOTAL_SRR   = GS55["total_rna"]              # SRR444655
RNASER_SRRS = GS55["rnaser"]                 # [SRR444974, SRR445016]
ALL_GSE55   = [TOTAL_SRR] + RNASER_SRRS

RESULTS    = BENCH["output_dir"]
# workflow.snakefile is benchmark/Snakefile; go up one level to get circRNA_agent root
AGENT_DIR  = os.path.dirname(os.path.dirname(os.path.abspath(workflow.snakefile)))

# nf-core 3-tool simulation prerequisites
# CIRCexplorer2: conda install -c bioconda circexplorer2
# find_circ:     git clone https://github.com/marvin-jens/find_circ to GENOME["find_circ_dir"]
#                conda install -c bioconda bowtie2
# bowtie2 index: bowtie2-build --threads 8 hg19.fa {GENOME["bowtie2_index"]}

# Derived from config
DE_FDR          = config.get("de_fdr",          0.05)
DE_LFC          = config.get("de_lfc",           1.0)
DE_TUMOR_LABEL  = config.get("de_tumor_label",  "tumor")
DE_NORMAL_LABEL = config.get("de_normal_label", "normal")

RAW_DIR = GS55.get("raw_dir", "/home3/choukaihsuan/GSE55872/raw")

wildcard_constraints:
    srr = r"[A-Z]+\d+"


# ─── Target ───────────────────────────────────────────────────────────────────
rule all:
    input:
        RESULTS + "/comparison_report.html"


# ═══════════════════════════════════════════════════════════════════════════════
# GSE55872: 下載 + Trim（前置作業）
# ═══════════════════════════════════════════════════════════════════════════════

rule bench_download:
    """Download GSE55872 SRR FASTQ.gz directly from EBI (faster than NCBI prefetch)."""
    output:
        r1 = RAW_DIR + "/{srr}_1.fastq.gz",
        r2 = RAW_DIR + "/{srr}_2.fastq.gz",
    params:
        raw_dir = RAW_DIR,
        srr     = "{srr}",
        # EBI URL pattern: first 6 chars of SRR as subdirectory
        ebi_base = lambda w: (
            f"https://ftp.sra.ebi.ac.uk/vol1/fastq/"
            f"{w.srr[:6]}/{w.srr}"
        ),
    threads: 2
    resources:
        mem_gb = 2
    log: "logs/bench/download_{srr}.log"
    shell:
        # --tries + --waitretry survive transient DNS failures and mid-transfer
        # stalls (observed on this server against EBI FTP: a DNS resolution
        # failure, and separately a ~2h stall before a bare wget silently gave
        # up); -c resumes a partial download instead of restarting from zero.
        """
        mkdir -p {params.raw_dir}
        wget -q --tries=5 --waitretry=30 --timeout=60 -c \
            -O {output.r1} \
            "{params.ebi_base}/{params.srr}_1.fastq.gz" \
            >> {log} 2>&1
        wget -q --tries=5 --waitretry=30 --timeout=60 -c \
            -O {output.r2} \
            "{params.ebi_base}/{params.srr}_2.fastq.gz" \
            >> {log} 2>&1
        """


rule bench_fastp:
    """Trim adapters and low-quality bases with fastp."""
    input:
        r1 = RAW_DIR + "/{srr}_1.fastq.gz",
        r2 = RAW_DIR + "/{srr}_2.fastq.gz",
    output:
        r1   = GS55["trimmed_dir"] + "/{srr}_1.fastq.gz",
        r2   = GS55["trimmed_dir"] + "/{srr}_2.fastq.gz",
        json = GS55["trimmed_dir"] + "/{srr}_fastp.json",
        html = GS55["trimmed_dir"] + "/{srr}_fastp.html",
    threads: 4
    resources:
        mem_gb = 4
    log: "logs/bench/fastp_{srr}.log"
    shell:
        """
        mkdir -p {GS55[trimmed_dir]}
        fastp \
            -i {input.r1} -I {input.r2} \
            -o {output.r1} -O {output.r2} \
            --json {output.json} --html {output.html} \
            --thread {threads} \
            --detect_adapter_for_pe \
            --qualified_quality_phred 20 \
            --length_required 50 \
            > {log} 2>&1
        """


# ═══════════════════════════════════════════════════════════════════════════════
# GSE55872: CIRIquant（三個 SRR 各自跑）
# ═══════════════════════════════════════════════════════════════════════════════

rule bench_ciriquant:
    """Run CIRIquant on a GSE55872 sample (total RNA or RNase R)."""
    input:
        r1  = GS55["trimmed_dir"] + "/{srr}_1.fastq.gz",
        r2  = GS55["trimmed_dir"] + "/{srr}_2.fastq.gz",
    output:
        gtf      = GS55["results_dir"] + "/circRNA/{srr}/{srr}.gtf",
        time_log = "logs/bench/time_ciriquant_{srr}.log",
    params:
        outdir = GS55["results_dir"] + "/circRNA/{srr}",
        sample = "{srr}",
        cfg    = config["ciriquant_config"],
    threads: 8  # fixed for reproducible benchmark timing
    resources:
        mem_gb = 16
    log: "logs/bench/ciriquant_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        /usr/bin/time -v -o {output.time_log} \
            CIRIquant -t {threads} \
            -1 {input.r1} -2 {input.r2} \
            --config {params.cfg} \
            -o {params.outdir} \
            -p {params.sample} \
            > {log} 2>&1
        rm -rf {params.outdir}/circ {params.outdir}/align {params.outdir}/gene
        """


# ─── STAR alignment for SRR444655 only (DCC requires STAR junctions) ─────────

rule bench_star_paired:
    """STAR paired-end alignment (for DCC chimeric junctions)."""
    input:
        r1 = GS55["trimmed_dir"] + "/{srr}_1.fastq.gz",
        r2 = GS55["trimmed_dir"] + "/{srr}_2.fastq.gz",
    output:
        junc     = GS55["results_dir"] + "/circRNA/{srr}/Chimeric.out.junction",
        bam      = GS55["results_dir"] + "/circRNA/{srr}/Aligned.sortedByCoord.out.bam",
        time_log = "logs/bench/time_star_paired_{srr}.log",
    params:
        index  = GENOME["star_index"],
        prefix = GS55["results_dir"] + "/circRNA/{srr}/",
        tmp    = GS55["results_dir"] + "/circRNA/{srr}/star_tmp",
    threads: 8  # fixed for reproducible benchmark timing
    resources:
        mem_gb = 26
    log: "logs/bench/star_paired_{srr}.log"
    shell:
        """
        mkdir -p {params.tmp}
        SORT_TMP=/home3/choukaihsuan/timing_tmp/samtools_sort_{wildcards.srr}
        mkdir -p $SORT_TMP
        /usr/bin/time -v -o {output.time_log} \
            sh -c 'STAR --runThreadN {threads} --genomeDir {params.index} \
             --readFilesIn {input.r1} {input.r2} \
             --readFilesCommand zcat \
             --outSAMtype BAM Unsorted \
             --outFileNamePrefix {params.prefix} \
             --outTmpDir {params.tmp}/_STARtmp \
             --chimSegmentMin 5 --chimOutType Junctions \
             --chimJunctionOverhangMin 5 \
             --alignSJDBoverhangMin 5 \
             --outSAMattributes NH HI NM MD AS \
             > {log} 2>&1 \
             && samtools sort -@ {threads} -m 2G \
                -T '"$SORT_TMP"'/sort \
                {params.prefix}Aligned.out.bam \
                -o {output.bam} \
             && samtools index {output.bam} \
             && rm -f {params.prefix}Aligned.out.bam'
        rm -rf {params.tmp} $SORT_TMP
        """


