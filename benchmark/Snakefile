            --output            {output} \
            2>&1 | tee {log}
        """


# ═══════════════════════════════════════════════════════════════════════════════
# Task 2c – DE quality: run DESeq2 on GSE113230 (nf-core simulation)
# ═══════════════════════════════════════════════════════════════════════════════

rule de_deseq2_baseline:
    """
    Run all 3 DE methods (DESeq2 primary + limma side-product) on GSE113230 BSJ counts.
    No FSJ matrix → edgeR_ciriquant is skipped; DESeq2 and limma-voom both run.
    """
    input:
        matrix = GS113["count_matrix"],
        groups = GS113["groups"],
    output:
        de       = RESULTS + "/de/nfcore_deseq2_results.tsv",
        de_deseq = RESULTS + "/de/nfcore_deseq2_only.tsv",
        de_limma = RESULTS + "/de/nfcore_limma_results.tsv",
        volcano  = RESULTS + "/de/plots/nfcore_volcano.pdf",
        heatmap  = RESULTS + "/de/plots/nfcore_heatmap.pdf",
        pca      = RESULTS + "/de/plots/nfcore_pca.pdf",
    params:
        de_method    = "deseq2",
        fdr          = DE_FDR,
        lfc          = DE_LFC,
        tumor_label  = DE_TUMOR_LABEL,
        normal_label = DE_NORMAL_LABEL,
    log: "logs/bench/de_deseq2_baseline.log"
    script:
        "../scripts/analysis.R"


rule de_quality_benchmark:
    """Compare DE analysis quality: edgeR_ciriquant vs DESeq2 vs limma-voom."""
    input:
        our_de    = GS113["de_results"],
        nfcore_de = RESULTS + "/de/nfcore_deseq2_results.tsv",
        limma_de  = RESULTS + "/de/nfcore_limma_results.tsv",
    output:
        summary = RESULTS + "/de_quality_summary.tsv",
        jaccard = RESULTS + "/de_jaccard.tsv",
    params:
        circbase_arg = (
            f"--circbase-annot {GS113['circbase_annot']}"
            if GS113.get("circbase_annot") and
               os.path.exists(GS113.get("circbase_annot", ""))
            else ""
        ),
        fdr  = DE_FDR,
        lfc  = DE_LFC,
    log: "logs/bench/de_quality.log"
    shell:
        """
        python {AGENT_DIR}/benchmark/scripts/de_quality_benchmark.py \
            --our-de         {input.our_de} \
            --nfcore-de      {input.nfcore_de} \
            --circompara2-de {input.nfcore_de} \
            --clear-de       {input.nfcore_de} \
            --limma-de       {input.limma_de} \
            --output-summary {output.summary} \
            --output-jaccard {output.jaccard} \
            --fdr {params.fdr} \
            --lfc {params.lfc} \
            {params.circbase_arg} \
            2>&1 | tee {log}
        """


