rule accuracy_benchmark:
    """Compute Precision/Recall/F1/AUC-PR for detection strategies (incl. no-QC ablation and 5-tool CirComPara2)."""
    input:
        ground_truth        = RESULTS + "/rnaser/ground_truth.tsv",
        our_bed             = RESULTS + "/detection/our_method.bed",
        our_summary         = RESULTS + "/detection/our_method_summary.tsv",
        our_no_qc_bed       = RESULTS + "/detection/our_no_qc.bed",
        our_no_qc_summary   = RESULTS + "/detection/our_no_qc_summary.tsv",
        circompara2_bed     = RESULTS + "/detection/circompara2_sim.bed",
        circompara2_summary = RESULTS + "/detection/circompara2_sim_summary.tsv",
        circompara2_4tools_bed     = RESULTS + "/detection/circompara2_4tools.bed",
        circompara2_4tools_summary = RESULTS + "/detection/circompara2_4tools_summary.tsv",
        nfcore_bed          = RESULTS + "/detection/nfcore_3tools.bed",
        nfcore_summary      = RESULTS + "/detection/nfcore_3tools_summary.tsv",
    output:
        summary       = RESULTS + "/accuracy_summary.tsv",
        stratified    = RESULTS + "/stratified_f1.tsv",
        fp_comparison = RESULTS + "/fp_score_comparison.tsv",
    params:
