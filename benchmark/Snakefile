rule bench_dcc:
    """Run DCC on SRR444655 (total RNA sample used for accuracy benchmark)."""
    input:
        junc  = GS55["results_dir"] + "/circRNA/{srr}/Chimeric.out.junction",
        junc1 = GS55["results_dir"] + "/circRNA/{srr}/mate1/Chimeric.out.junction",
        junc2 = GS55["results_dir"] + "/circRNA/{srr}/mate2/Chimeric.out.junction",
        bam   = GS55["results_dir"] + "/circRNA/{srr}/Aligned.sortedByCoord.out.bam",
        gtf   = GENOME["gtf"],
    output:
        coords   = GS55["results_dir"] + "/circRNA/{srr}/DCC/CircCoordinates",
        time_log = "logs/bench/time_dcc_{srr}.log",
    params:
        outdir = GS55["results_dir"] + "/circRNA/{srr}/DCC",
    threads: 8  # fixed for reproducible benchmark timing
    log: "logs/bench/dcc_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        /usr/bin/time -v -o {output.time_log} \
            sh -c '( cd {params.outdir} && DCC {input.junc} \
              -mt1 {input.junc1} \
              -mt2 {input.junc2} \
              -D -an {input.gtf} \
              -Pi -F -M -Nr 2 1 \
              -G -B {input.bam} \
              -O {params.outdir} \
              -T {threads} ) \
              > {log} 2>&1'
        """


# ═══════════════════════════════════════════════════════════════════════════════
# Task 1 – RNase R ground truth
# ═══════════════════════════════════════════════════════════════════════════════

rule ground_truth:
    """Compute enrichment ratios and label TP/TN from RNase R data."""
    input:
        total  = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
        rnaser = expand(
            GS55["results_dir"] + "/circRNA/{srr}/{srr}.gtf",
            srr=RNASER_SRRS,
        ),
    output:
        RESULTS + "/rnaser/ground_truth.tsv",
    params:
        er_tp = BENCH.get("er_tp_threshold", 1.5),
        er_tn = BENCH.get("er_tn_threshold", 0.5),
        slop  = BENCH.get("slop", 10),
    log: "logs/bench/ground_truth.log"
    shell:
        """
        python {AGENT_DIR}/benchmark/scripts/rnaser_ground_truth.py \
            --total   {input.total} \
            --rnaser  {input.rnaser} \
            --output  {output} \
            --er-tp   {params.er_tp} \
            --er-tn   {params.er_tn} \
            --slop    {params.slop} \
            2>&1 | tee {log}
        """


# ═══════════════════════════════════════════════════════════════════════════════
# Task 2a – Three detection strategies on SRR444655
# ═══════════════════════════════════════════════════════════════════════════════

rule our_filter:
    """
    Our adaptive consensus filter:
    CIRIquant + DCC, slop=10 bp, BSJ/FSJ pseudo-circ QC enabled.
    """
    input:
        cirique = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
        dcc     = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/DCC/CircCoordinates",
    output:
        bed      = RESULTS + "/detection/our_method.bed",
        summary  = RESULTS + "/detection/our_method_summary.tsv",
        time_log = "logs/bench/time_consensus.log",
    params:
        slop               = BENCH.get("slop", 10),
        min_bsj            = BENCH.get("min_bsj", 2),
        max_junction_ratio = BENCH.get("max_junction_ratio", 1.0),
        min_confidence     = BENCH.get("min_confidence", 0.0),
    log: "logs/bench/our_filter.log"
    shell:
        """
        /usr/bin/time -v -o {output.time_log} \
            python {AGENT_DIR}/scripts/consensus_filter.py \
                --cirique {input.cirique} \
                --dcc     {input.dcc} \
                --output  {output.bed} \
                --summary {output.summary} \
                --min-tools 2 \
                --slop {params.slop} \
                --min-bsj {params.min_bsj} \
                --max-junction-ratio {params.max_junction_ratio} \
                --adaptive --adaptive-ratio 0.1 \
                --min-confidence {params.min_confidence} \
                2>&1 | tee {log}
        """


rule our_no_qc_filter:
    """
    Our method WITHOUT pseudo-circ QC (max_junction_ratio=99):
    CIRIquant + DCC, slop=10 bp, adaptive — no BSJ/FSJ ratio filter.
    Used to measure F1 upper bound and tune max_junction_ratio.
    """
    input:
        cirique = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
        dcc     = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/DCC/CircCoordinates",
    output:
        bed     = RESULTS + "/detection/our_no_qc.bed",
        summary = RESULTS + "/detection/our_no_qc_summary.tsv",
    params:
        slop    = BENCH.get("slop", 10),
        min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench/our_no_qc_filter.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique {input.cirique} \
            --dcc     {input.dcc} \
            --output  {output.bed} \
            --summary {output.summary} \
            --min-tools 2 \
            --slop {params.slop} \
            --min-bsj {params.min_bsj} \
            --max-junction-ratio 99 \
            --adaptive --adaptive-ratio 0.1 \
            2>&1 | tee {log}
        """


rule bench_ciri2:
    """
    CIRI2 circRNA detection (BWA-MEM alignment → CIRI2.pl).
    CIRI2 is bundled with CIRIquant; uses same BWA index.
    Required for full 5-tool CirComPara2 simulation.
    """
    input:
        r1 = GS55["trimmed_dir"] + "/{srr}_1.fastq.gz",
        r2 = GS55["trimmed_dir"] + "/{srr}_2.fastq.gz",
    output:
        ciri2  = GS55["results_dir"] + "/circRNA/{srr}/CIRI2/{srr}.ciri2",
        time_log = "logs/bench/time_ciri2_{srr}.log",
    params:
        outdir = GS55["results_dir"] + "/circRNA/{srr}/CIRI2",
        ciri2_pl = GENOME.get("ciri2_pl", "/home3/choukaihsuan/miniconda3/envs/ciriquant/lib/python3.7/site-packages/libs/CIRI2.pl"),
        bwa_index = GENOME["bwa_index"],
        genome    = GENOME["fasta"],
        gtf       = GENOME["gtf"],
        sample    = "{srr}",
    threads: 8
    resources:
        mem_gb = 32
    log: "logs/bench/ciri2_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        SAM={params.outdir}/{params.sample}.sam
        # BWA-MEM alignment (CIRI2 requires unsorted SAM)
        /usr/bin/time -v -o {output.time_log} bash -c "
            bwa mem -T 19 -t {threads} \
                {params.bwa_index} \
                {input.r1} {input.r2} \
                > $SAM \
                2> {params.outdir}/bwa.log && \
            perl {params.ciri2_pl} \
                -I $SAM \
                -O {output.ciri2} \
                -F {params.genome} \
                -A {params.gtf} \
                -T {threads} \
                >> {log} 2>&1 && \
            rm -f $SAM
        " 2>> {log}
        """


rule circompara2_4tools_filter:
    """
    CirComPara2 4-tool simulation (Gaffo et al. 2022, Briefings Bioinformatics):
    CIRIquant + DCC + CIRCexplorer2 + find_circ; ≥2/4 consensus; slop=10 bp.
    CIRI2 excluded: CIRIquant already uses CIRI2 internally for BSJ detection,
    so including both would double-count the same algorithm.
    BSJ/FSJ QC disabled (CirComPara2 does not apply pseudo-circ filtering).
    """
    input:
        cirique      = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
        dcc          = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/DCC/CircCoordinates",
        circexplorer = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/CIRCexplorer2/known_circ.txt",
        find_circ    = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/find_circ/splice_sites.bed",
    output:
        bed     = RESULTS + "/detection/circompara2_4tools.bed",
        summary = RESULTS + "/detection/circompara2_4tools_summary.tsv",
    params:
        slop    = BENCH.get("slop", 10),
        min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench/circompara2_4tools_filter.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique      {input.cirique} \
            --dcc          {input.dcc} \
            --circexplorer2 {input.circexplorer} \
            --find-circ    {input.find_circ} \
            --output       {output.bed} \
            --summary      {output.summary} \
            --min-tools 2 \
            --slop {params.slop} \
            --min-bsj {params.min_bsj} \
            --max-junction-ratio 999 \
            2>&1 | tee {log}
        """


rule circompara2_sim_filter:
    """
    CirComPara2 2-tool simulation (legacy, for ablation vs. Our_no_QC):
    CIRIquant + DCC only, slop=10 bp, BSJ/FSJ QC DISABLED.
    Isolates the contribution of our pseudo-circ QC step.
    Use circompara2_5tools_filter for the full 5-tool comparison.
    """
    input:
        cirique = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
        dcc     = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/DCC/CircCoordinates",
    output:
        bed     = RESULTS + "/detection/circompara2_sim.bed",
        summary = RESULTS + "/detection/circompara2_sim_summary.tsv",
    params:
        slop    = BENCH.get("slop", 10),
        min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench/circompara2_sim_filter.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique {input.cirique} \
            --dcc     {input.dcc} \
            --output  {output.bed} \
            --summary {output.summary} \
            --min-tools 2 \
            --slop {params.slop} \
            --min-bsj {params.min_bsj} \
            --max-junction-ratio 999 \
            2>&1 | tee {log}
        """


rule bench_circexplorer2:
    """
    CIRCexplorer2 circRNA detection using existing STAR chimeric junctions.
    Step 1 (parse): Chimeric.out.junction → back_spliced_junction.bed
    Step 2 (annotate): annotate with refFlat → known_circ.txt
    Prerequisites: conda install -c bioconda circexplorer2
    """
    input:
        junc   = GS55["results_dir"] + "/circRNA/{srr}/Chimeric.out.junction",
        genome = GENOME["fasta"],
    output:
        bed      = GS55["results_dir"] + "/circRNA/{srr}/CIRCexplorer2/back_spliced_junction.bed",
        known    = GS55["results_dir"] + "/circRNA/{srr}/CIRCexplorer2/known_circ.txt",
        time_log = "logs/bench/time_circexplorer2_{srr}.log",
    params:
        outdir   = GS55["results_dir"] + "/circRNA/{srr}/CIRCexplorer2",
        ref_flat = GENOME.get("ref_flat", ""),
    threads: 2
    resources:
        mem_gb = 8
    log: "logs/bench/circexplorer2_{srr}.log"
    shell:
        # {log} is a relative path (logs/bench/...), so the `>` redirect must
        # stay OUTSIDE the cd'd subshell — same fix as the documented DCC log
        # path bug (CLAUDE.md: "cd {outdir} 後 > {log} 的相對路徑從 outdir 解析").
        """
        (
            mkdir -p {params.outdir}
            cd {params.outdir}
            /usr/bin/time -v -o {output.time_log} sh -c '
            CIRCexplorer2 parse -t STAR {input.junc} -b back_spliced_junction.bed
            CIRCexplorer2 annotate \
                -r {params.ref_flat} \
                -g {input.genome} \
                -b back_spliced_junction.bed
            mv {params.outdir}/circularRNA_known.txt {output.known} 2>/dev/null || true
            '
        ) > {log} 2>&1
        """


rule bench_find_circ_map:
    """
    Bowtie2 alignment to extract unmapped read pairs for find_circ.
    Prerequisites:
      - conda install -c bioconda bowtie2
      - bowtie2-build --threads 8 {genome.fa} {GENOME[bowtie2_index]}
    """
    input:
        r1 = GS55["trimmed_dir"] + "/{srr}_1.fastq.gz",
        r2 = GS55["trimmed_dir"] + "/{srr}_2.fastq.gz",
    output:
        unm_r1   = GS55["results_dir"] + "/circRNA/{srr}/find_circ/unmapped_1.fastq",
        unm_r2   = GS55["results_dir"] + "/circRNA/{srr}/find_circ/unmapped_2.fastq",
        time_log = "logs/bench/time_find_circ_map_{srr}.log",
    params:
        outdir = GS55["results_dir"] + "/circRNA/{srr}/find_circ",
        index  = GENOME.get("bowtie2_index", ""),
    threads: 8  # fixed for reproducible benchmark timing
    resources:
        mem_gb = 8
    log: "logs/bench/find_circ_map_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        /usr/bin/time -v -o {output.time_log} \
            bowtie2 -p {threads} --very-sensitive --mm \
                -x {params.index} \
                -1 {input.r1} -2 {input.r2} \
                --un-conc {params.outdir}/unmapped_%.fastq \
                -S /dev/null \
                2> {log}
        """


rule bench_find_circ:
    """
    find_circ circRNA detection from unmapped bowtie2 reads.
    Prerequisites:
      - git clone https://github.com/marvin-jens/find_circ {GENOME[find_circ_dir]}
      - conda install -c bioconda bowtie2 pysam
    """
    input:
        unm_r1 = GS55["results_dir"] + "/circRNA/{srr}/find_circ/unmapped_1.fastq",
        unm_r2 = GS55["results_dir"] + "/circRNA/{srr}/find_circ/unmapped_2.fastq",
    output:
        bed      = GS55["results_dir"] + "/circRNA/{srr}/find_circ/splice_sites.bed",
        time_log = "logs/bench/time_find_circ_{srr}.log",
    params:
        outdir        = GS55["results_dir"] + "/circRNA/{srr}/find_circ",
        index         = GENOME.get("bowtie2_index", ""),
        find_circ_dir = GENOME.get("find_circ_dir", ""),
        genome        = GENOME["fasta"],
        sample        = "{srr}",
    threads: 8  # fixed for reproducible benchmark timing
    resources:
        mem_gb = 8
    log: "logs/bench/find_circ_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        TMPFIFO={params.outdir}/unmapped_concat_$$.fastq
        mkfifo \$TMPFIFO
        cat {input.unm_r1} {input.unm_r2} > \$TMPFIFO &
        /usr/bin/time -v -o {output.time_log} \
            sh -c 'python {params.find_circ_dir}/unmapped2anchors.py --fastq {params.outdir}/unmapped_concat_$$.fastq | \
            bowtie2 -p {threads} --score-min=C,-15,0 --reorder \
                -x {params.index} -U - | \
            python {params.find_circ_dir}/find_circ.py \
                --genome={params.genome} \
                --prefix={params.sample} \
                --name={params.sample} \
                --stats={params.outdir}/find_circ_stats.txt \
                > {output.bed} \
                2>> {log}'
        rm -f \$TMPFIFO
        """


rule nfcore_3tools_filter:
    """
    nf-core/circrna simulation (Digby-Bell et al. 2023, BMC Bioinformatics):
    CIRIquant + CIRCexplorer2 + find_circ — the typical nf-core 3-tool combination.
    min_tools=2 (at least 2 of 3 tools agree), slop=0 (nf-core exact matching).
    BSJ/FSJ QC disabled (nf-core does not apply pseudo-circ filtering).
    """
    input:
        cirique      = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
        circexplorer = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/CIRCexplorer2/known_circ.txt",
        find_circ    = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/find_circ/splice_sites.bed",
    output:
        bed     = RESULTS + "/detection/nfcore_3tools.bed",
        summary = RESULTS + "/detection/nfcore_3tools_summary.tsv",
    params:
        min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench/nfcore_3tools_filter.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique      {input.cirique} \
            --circexplorer2 {input.circexplorer} \
            --find-circ    {input.find_circ} \
            --output       {output.bed} \
            --summary      {output.summary} \
            --min-tools 2 \
            --slop 0 \
            --min-bsj {params.min_bsj} \
            --max-junction-ratio 999 \
            2>&1 | tee {log}
        """


rule clear_sim_filter:
    """
    CLEAR simulation (Custom 2020 single-tool pipeline):
    CIRIquant only, slop=0 (exact coordinates), no consensus step.
    Represents single-tool pipelines that skip multi-tool validation.
    """
    input:
        cirique = GS55["results_dir"] + f"/circRNA/{TOTAL_SRR}/{TOTAL_SRR}.gtf",
    output:
        bed     = RESULTS + "/detection/clear_sim.bed",
        summary = RESULTS + "/detection/clear_sim_summary.tsv",
    params:
        min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench/clear_sim_filter.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique {input.cirique} \
            --output  {output.bed} \
            --summary {output.summary} \
            --min-tools 1 \
            --slop 0 \
            --min-bsj {params.min_bsj} \
            --max-junction-ratio 999 \
            2>&1 | tee {log}
        """


