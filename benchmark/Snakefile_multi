"""
Snakefile_multi -- accuracy-only RNase R benchmark for ADDITIONAL datasets.

Generalizes the detection chain from benchmark/Snakefile (bench_download ..
accuracy_benchmark) over a dict of independent RNase R +/- pairs, keyed by
{dataset}. Does NOT touch GSE55872's existing outputs or the main
benchmark/Snakefile at all -- this is a separate target set writing into its
own results_dir per dataset, created specifically for the committee-requested
3-dataset accuracy expansion (compute cost intentionally NOT redone here).

Settings are identical to the main benchmark/Snakefile for all three
detection strategies (same consensus_filter flags, same DCC -Nr 2, same
threshold-sweep accuracy method) -- only the input FASTQs differ.

Run:
  snakemake --snakefile benchmark/Snakefile_multi \
      --configfile benchmark/config_benchmark_multi.yaml \
      --cores 8 --resources mem_gb=60 \
      --keep-going --rerun-incomplete \
      -- <target files, one dataset at a time to respect disk/parallelism limits>
"""

import os

configfile: "benchmark/config_benchmark_multi.yaml"
shell.executable("bash")

DATASETS = config["datasets"]          # dict: name -> {total_rna, rnaser, raw_dir, trimmed_dir, results_dir}
GENOME   = config["genome"]
BENCH    = config["benchmark"]
AGENT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(workflow.snakefile)))

def ds(name):
    return DATASETS[name]

def all_srrs(name):
    d = ds(name)
    return [d["total_rna"]] + d["rnaser"]

wildcard_constraints:
    dataset = r"[A-Za-z0-9_]+",
    srr     = r"[A-Z]+\d+"

# Per-dataset directory helpers (wildcards.dataset resolved at rule eval time)
def RAW(w):     return ds(w.dataset)["raw_dir"]
def TRIM(w):    return ds(w.dataset)["trimmed_dir"]
def RES(w):     return ds(w.dataset)["results_dir"]

rule multi_all:
    input:
        expand("results/benchmark_multi/{dataset}/accuracy_summary.tsv",
               dataset=list(DATASETS.keys()))


# ═══ Download + trim ═══════════════════════════════════════════════════════

rule m_download:
    params:
        raw_dir = lambda w: RAW(w),
        srr     = "{srr}",
        ebi_base = lambda w: f"https://ftp.sra.ebi.ac.uk/vol1/fastq/{w.srr[:6]}/{w.srr}",
    output:
        r1 = "results/benchmark_multi/{dataset}/.raw/{srr}_1.fastq.gz",
        r2 = "results/benchmark_multi/{dataset}/.raw/{srr}_2.fastq.gz",
    threads: 2
    log: "logs/bench_multi/download_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.raw_dir}
        wget -q --tries=5 --waitretry=30 --timeout=60 -c -O {params.raw_dir}/{params.srr}_1.fastq.gz \
            "{params.ebi_base}/{params.srr}_1.fastq.gz" >> {log} 2>&1
        wget -q --tries=5 --waitretry=30 --timeout=60 -c -O {params.raw_dir}/{params.srr}_2.fastq.gz \
            "{params.ebi_base}/{params.srr}_2.fastq.gz" >> {log} 2>&1
        mkdir -p $(dirname {output.r1})
        ln -sf {params.raw_dir}/{params.srr}_1.fastq.gz {output.r1}
        ln -sf {params.raw_dir}/{params.srr}_2.fastq.gz {output.r2}
        """

rule m_fastp:
    input:
        r1 = "results/benchmark_multi/{dataset}/.raw/{srr}_1.fastq.gz",
        r2 = "results/benchmark_multi/{dataset}/.raw/{srr}_2.fastq.gz",
    params:
        trimmed_dir = lambda w: TRIM(w),
    output:
        r1   = "results/benchmark_multi/{dataset}/.trim/{srr}_1.fastq.gz",
        r2   = "results/benchmark_multi/{dataset}/.trim/{srr}_2.fastq.gz",
        json = "results/benchmark_multi/{dataset}/.trim/{srr}_fastp.json",
    threads: 4
    log: "logs/bench_multi/fastp_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.trimmed_dir} $(dirname {output.r1})
        fastp -i {input.r1} -I {input.r2} \
            -o {params.trimmed_dir}/{wildcards.srr}_1.fastq.gz \
            -O {params.trimmed_dir}/{wildcards.srr}_2.fastq.gz \
            --json {output.json} --html {params.trimmed_dir}/{wildcards.srr}_fastp.html \
            --thread {threads} --detect_adapter_for_pe \
            --qualified_quality_phred 20 --length_required 50 \
            > {log} 2>&1
        ln -sf {params.trimmed_dir}/{wildcards.srr}_1.fastq.gz {output.r1}
        ln -sf {params.trimmed_dir}/{wildcards.srr}_2.fastq.gz {output.r2}
        """

# ═══ CIRIquant ═══════════════════════════════════════════════════════════════

rule m_ciriquant:
    input:
        r1 = "results/benchmark_multi/{dataset}/.trim/{srr}_1.fastq.gz",
        r2 = "results/benchmark_multi/{dataset}/.trim/{srr}_2.fastq.gz",
    output:
        gtf = "results/benchmark_multi/{dataset}/circRNA/{srr}/{srr}.gtf",
    params:
        outdir = "results/benchmark_multi/{dataset}/circRNA/{srr}",
        cfg    = config["ciriquant_config"],
    threads: 8
    log: "logs/bench_multi/ciriquant_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        CIRIquant -t {threads} -1 {input.r1} -2 {input.r2} \
            --config {params.cfg} -o {params.outdir} -p {wildcards.srr} \
            > {log} 2>&1
        rm -rf {params.outdir}/circ {params.outdir}/align {params.outdir}/gene
        """

# ═══ STAR (paired + mate1 + mate2) ═══════════════════════════════════════════

rule m_star_paired:
    input:
        r1 = "results/benchmark_multi/{dataset}/.trim/{srr}_1.fastq.gz",
        r2 = "results/benchmark_multi/{dataset}/.trim/{srr}_2.fastq.gz",
    output:
        junc = "results/benchmark_multi/{dataset}/circRNA/{srr}/Chimeric.out.junction",
        bam  = "results/benchmark_multi/{dataset}/circRNA/{srr}/Aligned.sortedByCoord.out.bam",
    params:
        index  = GENOME["star_index"],
        prefix = "results/benchmark_multi/{dataset}/circRNA/{srr}/",
        tmp    = "results/benchmark_multi/{dataset}/circRNA/{srr}/star_tmp",
    threads: 8
    log: "logs/bench_multi/star_paired_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.tmp}
        SORT_TMP=/home3/choukaihsuan/timing_tmp/mm_sort_{wildcards.dataset}_{wildcards.srr}
        mkdir -p $SORT_TMP
        STAR --runThreadN {threads} --genomeDir {params.index} \
             --readFilesIn {input.r1} {input.r2} --readFilesCommand zcat \
             --outSAMtype BAM Unsorted --outFileNamePrefix {params.prefix} \
             --outTmpDir {params.tmp}/_STARtmp \
             --chimSegmentMin 5 --chimOutType Junctions \
             --chimJunctionOverhangMin 5 --alignSJDBoverhangMin 5 \
             --outSAMattributes NH HI NM MD AS \
             > {log} 2>&1
        samtools sort -@ {threads} -m 2G -T $SORT_TMP/sort \
            {params.prefix}Aligned.out.bam -o {output.bam}
        samtools index {output.bam}
        rm -f {params.prefix}Aligned.out.bam
        rm -rf {params.tmp} $SORT_TMP
        """

rule m_star_mate1:
    input: r1 = "results/benchmark_multi/{dataset}/.trim/{srr}_1.fastq.gz"
    output: junc = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate1/Chimeric.out.junction"
    params:
        index  = GENOME["star_index"],
        prefix = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate1/",
        tmp    = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate1_tmp",
    threads: 8
    log: "logs/bench_multi/star_mate1_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.tmp}
        STAR --runThreadN {threads} --genomeDir {params.index} \
             --readFilesIn {input.r1} --readFilesCommand zcat \
             --outSAMtype BAM Unsorted --outFileNamePrefix {params.prefix} \
             --outTmpDir {params.tmp}/_STARtmp \
             --chimSegmentMin 5 --chimOutType Junctions \
             --chimJunctionOverhangMin 5 --alignSJDBoverhangMin 5 \
             > {log} 2>&1
        rm -rf {params.tmp}
        """

rule m_star_mate2:
    input: r2 = "results/benchmark_multi/{dataset}/.trim/{srr}_2.fastq.gz"
    output: junc = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate2/Chimeric.out.junction"
    params:
        index  = GENOME["star_index"],
        prefix = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate2/",
        tmp    = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate2_tmp",
    threads: 8
    log: "logs/bench_multi/star_mate2_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.tmp}
        STAR --runThreadN {threads} --genomeDir {params.index} \
             --readFilesIn {input.r2} --readFilesCommand zcat \
             --outSAMtype BAM Unsorted --outFileNamePrefix {params.prefix} \
             --outTmpDir {params.tmp}/_STARtmp \
             --chimSegmentMin 5 --chimOutType Junctions \
             --chimJunctionOverhangMin 5 --alignSJDBoverhangMin 5 \
             > {log} 2>&1
        rm -rf {params.tmp}
        """

# ═══ DCC ═════════════════════════════════════════════════════════════════════

rule m_dcc:
    input:
        junc  = "results/benchmark_multi/{dataset}/circRNA/{srr}/Chimeric.out.junction",
        junc1 = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate1/Chimeric.out.junction",
        junc2 = "results/benchmark_multi/{dataset}/circRNA/{srr}/mate2/Chimeric.out.junction",
        bam   = "results/benchmark_multi/{dataset}/circRNA/{srr}/Aligned.sortedByCoord.out.bam",
        gtf   = GENOME["gtf"],
    output:
        coords     = "results/benchmark_multi/{dataset}/circRNA/{srr}/DCC/CircCoordinates",
        circ_count = "results/benchmark_multi/{dataset}/circRNA/{srr}/DCC/CircRNACount",
    params:
        outdir = "results/benchmark_multi/{dataset}/circRNA/{srr}/DCC",
    threads: 8
    log: "logs/bench_multi/dcc_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        ( cd {params.outdir} && DCC {input.junc} -mt1 {input.junc1} -mt2 {input.junc2} \
            -D -an {input.gtf} -Pi -F -M -Nr 2 1 -G -B {input.bam} \
            -O {params.outdir} -T {threads} ) > {log} 2>&1
        """

# ═══ CIRI2 (threshold-sweep input) ══════════════════════════════════════════

rule m_ciri2:
    input:
        r1 = "results/benchmark_multi/{dataset}/.trim/{srr}_1.fastq.gz",
        r2 = "results/benchmark_multi/{dataset}/.trim/{srr}_2.fastq.gz",
    output:
        ciri2 = "results/benchmark_multi/{dataset}/circRNA/{srr}/CIRI2/{srr}.ciri2",
    params:
        outdir    = "results/benchmark_multi/{dataset}/circRNA/{srr}/CIRI2",
        ciri2_pl  = GENOME.get("ciri2_pl"),
        bwa_index = GENOME["bwa_index"],
        genome    = GENOME["fasta"],
        gtf       = GENOME["gtf"],
    threads: 8
    log: "logs/bench_multi/ciri2_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        SAM={params.outdir}/{wildcards.srr}.sam
        bwa mem -T 19 -t {threads} {params.bwa_index} {input.r1} {input.r2} \
            > $SAM 2> {params.outdir}/bwa.log
        perl {params.ciri2_pl} -I $SAM -O {output.ciri2} \
            -F {params.genome} -A {params.gtf} -T {threads} >> {log} 2>&1
        rm -f $SAM
        """

# ═══ CIRCexplorer2 ═══════════════════════════════════════════════════════════

rule m_circexplorer2:
    input:
        junc   = "results/benchmark_multi/{dataset}/circRNA/{srr}/Chimeric.out.junction",
        genome = GENOME["fasta"],
    output:
        known = "results/benchmark_multi/{dataset}/circRNA/{srr}/CIRCexplorer2/known_circ.txt",
    params:
        outdir   = "results/benchmark_multi/{dataset}/circRNA/{srr}/CIRCexplorer2",
        ref_flat = GENOME.get("ref_flat", ""),
    threads: 2
    log: "logs/bench_multi/circexplorer2_{dataset}_{srr}.log"
    shell:
        """
        (
            mkdir -p {params.outdir}
            cd {params.outdir}
            CIRCexplorer2 parse -t STAR {input.junc} -b back_spliced_junction.bed
            CIRCexplorer2 annotate -r {params.ref_flat} -g {input.genome} \
                -b back_spliced_junction.bed
            mv circularRNA_known.txt {wildcards.srr}.known_circ.txt 2>/dev/null || true
            mv {wildcards.srr}.known_circ.txt known_circ.txt 2>/dev/null || true
        ) > {log} 2>&1
        """

# ═══ find_circ (map + detect) ════════════════════════════════════════════════

rule m_find_circ_map:
    input:
        r1 = "results/benchmark_multi/{dataset}/.trim/{srr}_1.fastq.gz",
        r2 = "results/benchmark_multi/{dataset}/.trim/{srr}_2.fastq.gz",
    output:
        unm_r1 = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ/unmapped_1.fastq",
        unm_r2 = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ/unmapped_2.fastq",
    params:
        outdir = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ",
        index  = GENOME.get("bowtie2_index", ""),
    threads: 8
    log: "logs/bench_multi/find_circ_map_{dataset}_{srr}.log"
    shell:
        """
        mkdir -p {params.outdir}
        bowtie2 -p {threads} --very-sensitive --mm -x {params.index} \
            -1 {input.r1} -2 {input.r2} \
            --un-conc {params.outdir}/unmapped_%.fastq -S /dev/null \
            2> {log}
        """

rule m_find_circ:
    input:
        unm_r1 = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ/unmapped_1.fastq",
        unm_r2 = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ/unmapped_2.fastq",
    output:
        bed = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ/splice_sites.bed",
    params:
        outdir        = "results/benchmark_multi/{dataset}/circRNA/{srr}/find_circ",
        index         = GENOME.get("bowtie2_index", ""),
        find_circ_dir = GENOME.get("find_circ_dir", ""),
        genome        = GENOME["fasta"],
    threads: 8
    log: "logs/bench_multi/find_circ_{dataset}_{srr}.log"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        TMPFIFO={params.outdir}/unmapped_concat_$$.fastq
        mkfifo "$TMPFIFO"
        cat {input.unm_r1} {input.unm_r2} > "$TMPFIFO" &
        sh -c "set -o pipefail; python {params.find_circ_dir}/unmapped2anchors.py --fastq $TMPFIFO | \
            bowtie2 -p {threads} --score-min=C,-15,0 --reorder \
                -x {params.index} -U - | \
            python {params.find_circ_dir}/find_circ.py \
                --genome={params.genome} --prefix={wildcards.srr} --name={wildcards.srr} \
                --stats={params.outdir}/find_circ_stats.txt \
                > {output.bed} \
                2>> {log}"
        rm -f "$TMPFIFO"
        """

# ═══ Three consensus strategies (identical settings to main benchmark) ═══════

rule m_our_filter:
    input:
        cirique = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/{ds(w.dataset)['total_rna']}.gtf",
        dcc     = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/DCC/CircCoordinates",
    output:
        bed     = "results/benchmark_multi/{dataset}/detection/our_method.bed",
        summary = "results/benchmark_multi/{dataset}/detection/our_method_summary.tsv",
    params:
        slop = BENCH.get("slop", 10), min_bsj = BENCH.get("min_bsj", 2),
        mjr  = BENCH.get("max_junction_ratio", 1.0),
    log: "logs/bench_multi/our_filter_{dataset}.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique {input.cirique} --dcc {input.dcc} \
            --output {output.bed} --summary {output.summary} \
            --min-tools 2 --slop {params.slop} --min-bsj {params.min_bsj} \
            --max-junction-ratio {params.mjr} --adaptive --adaptive-ratio 0.1 \
            2>&1 | tee {log}
        """

rule m_circompara2_4tools_filter:
    input:
        cirique      = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/{ds(w.dataset)['total_rna']}.gtf",
        dcc          = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/DCC/CircCoordinates",
        circexplorer = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/CIRCexplorer2/known_circ.txt",
        find_circ    = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/find_circ/splice_sites.bed",
    output:
        bed     = "results/benchmark_multi/{dataset}/detection/circompara2_4tools.bed",
        summary = "results/benchmark_multi/{dataset}/detection/circompara2_4tools_summary.tsv",
    params:
        slop = BENCH.get("slop", 10), min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench_multi/circompara2_4tools_{dataset}.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique {input.cirique} --dcc {input.dcc} \
            --circexplorer2 {input.circexplorer} --find-circ {input.find_circ} \
            --output {output.bed} --summary {output.summary} \
            --min-tools 2 --slop {params.slop} --min-bsj {params.min_bsj} \
            --max-junction-ratio 999 \
            2>&1 | tee {log}
        """

rule m_nfcore_3tools_filter:
    input:
        cirique      = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/{ds(w.dataset)['total_rna']}.gtf",
        circexplorer = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/CIRCexplorer2/known_circ.txt",
        find_circ    = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/find_circ/splice_sites.bed",
    output:
        bed     = "results/benchmark_multi/{dataset}/detection/nfcore_3tools.bed",
        summary = "results/benchmark_multi/{dataset}/detection/nfcore_3tools_summary.tsv",
    params:
        min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench_multi/nfcore_3tools_{dataset}.log"
    shell:
        """
        python {AGENT_DIR}/scripts/consensus_filter.py \
            --cirique {input.cirique} --circexplorer2 {input.circexplorer} \
            --find-circ {input.find_circ} \
            --output {output.bed} --summary {output.summary} \
            --min-tools 2 --slop 0 --min-bsj {params.min_bsj} \
            --max-junction-ratio 999 \
            2>&1 | tee {log}
        """

# ═══ Ground truth + accuracy (threshold sweep) ══════════════════════════════

rule m_ground_truth:
    input:
        total  = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/{ds(w.dataset)['total_rna']}.gtf",
        rnaser = lambda w: [f"results/benchmark_multi/{w.dataset}/circRNA/{s}/{s}.gtf" for s in ds(w.dataset)["rnaser"]],
    output:
        "results/benchmark_multi/{dataset}/rnaser/ground_truth.tsv",
    params:
        er_tp = BENCH.get("er_tp_threshold", 1.5), er_tn = BENCH.get("er_tn_threshold", 0.5),
        slop  = BENCH.get("slop", 10),
    log: "logs/bench_multi/ground_truth_{dataset}.log"
    shell:
        """
        python {AGENT_DIR}/benchmark/scripts/rnaser_ground_truth.py \
            --total {input.total} --rnaser {input.rnaser} --output {output} \
            --er-tp {params.er_tp} --er-tn {params.er_tn} --slop {params.slop} \
            2>&1 | tee {log}
        """

rule m_accuracy_benchmark:
    input:
        ground_truth = "results/benchmark_multi/{dataset}/rnaser/ground_truth.tsv",
        our_bed      = "results/benchmark_multi/{dataset}/detection/our_method.bed",
        our_summary  = "results/benchmark_multi/{dataset}/detection/our_method_summary.tsv",
        c4_bed       = "results/benchmark_multi/{dataset}/detection/circompara2_4tools.bed",
        c4_summary   = "results/benchmark_multi/{dataset}/detection/circompara2_4tools_summary.tsv",
        nf_bed       = "results/benchmark_multi/{dataset}/detection/nfcore_3tools.bed",
        nf_summary   = "results/benchmark_multi/{dataset}/detection/nfcore_3tools_summary.tsv",
        ciri2        = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/CIRI2/{ds(w.dataset)['total_rna']}.ciri2",
        dcc_count    = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/DCC/CircRNACount",
        ce2          = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/CIRCexplorer2/known_circ.txt",
        fc           = lambda w: f"results/benchmark_multi/{w.dataset}/circRNA/{ds(w.dataset)['total_rna']}/find_circ/splice_sites.bed",
    output:
        summary       = "results/benchmark_multi/{dataset}/accuracy_summary.tsv",
        pr_curve      = "results/benchmark_multi/{dataset}/pr_curve.tsv",
    params:
        slop = BENCH.get("slop", 10), min_bsj = BENCH.get("min_bsj", 2),
    log: "logs/bench_multi/accuracy_{dataset}.log"
    shell:
        """
        python {AGENT_DIR}/benchmark/scripts/accuracy_benchmark.py \
            --ground-truth {input.ground_truth} \
            --our-bed {input.our_bed} --our-summary {input.our_summary} \
            --our-no-qc-bed {input.our_bed} --our-no-qc-summary {input.our_summary} \
            --circompara2-bed {input.c4_bed} --circompara2-summary {input.c4_summary} \
            --circompara2-4tools-bed {input.c4_bed} --circompara2-4tools-summary {input.c4_summary} \
            --nfcore-bed {input.nf_bed} --nfcore-summary {input.nf_summary} \
            --output-summary {output.summary} \
            --output-stratified results/benchmark_multi/{wildcards.dataset}/stratified_f1.tsv \
            --output-fp-comparison results/benchmark_multi/{wildcards.dataset}/fp_score_comparison.tsv \
            --slop {params.slop} --min-bsj {params.min_bsj} \
            --ciri2-file {input.ciri2} --dcc-count-file {input.dcc_count} \
            --circexplorer2-file {input.ce2} --find-circ-file {input.fc} \
            --output-pr-curve {output.pr_curve} \
            2>&1 | tee {log}
        """
