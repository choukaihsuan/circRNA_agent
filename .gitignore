# Data (large files, not for version control) - anchored to the repo root so a source
# directory that happens to be named data/ or results/ deeper in the tree is not swallowed
/data/
/results/

# Reference genome
/ref/

# Snakemake internals
.snakemake/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# Logs (optional: comment out if you want to track logs)
logs/
Log.out

# Conda env (recreatable from envs/circrna.yaml)
.conda/

# Accidentally created directories
CUsersUser/

# Claude Code local state (memory, settings.local.json, todos); repo-level skills stay committable
.claude/*
!.claude/skills/

# Snakemake-generated sentinel files
config/.ciriquant_ready

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Web UI runtime state: Flask SECRET_KEY, magic-link tokens, job queue (never commit)
jobs/
.env
.env.*

# Generated tables / figures: ignored by EXPLICIT filename (no *.png / *.tsv globs, which would
# also swallow legitimate files). Only the scripts that produce them are committed. When you add a
# generator under audit/, add its output file here by name.
examples/minimal/output/
audit/figs/figure13_ablation.png

# Guard against paper material ending up in the software repo (the manuscript lives elsewhere)
*.docx
*.doc
/paper/
/manuscript/
