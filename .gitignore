# Data (large files, not for version control)
data/
results/

# Reference genome
/ref/

# Snakemake internals
.snakemake/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# Logs (optional: comment out if you want to track logs)
logs/
Log.out

# web_ui.py runtime state: Flask secret_key.txt, job queue.db, auth_tokens.db
# (magic-link tokens, hashed session data). Never committed historically (git
# log --all --diff-filter=A --name-only confirms this, 2026-10-19 secret-scan),
# but also never previously excluded here -- added defensively so a future
# `git add -A` from inside jobs/ can't accidentally commit it.
jobs/

# Conda env (recreatable from envs/circrna.yaml)
.conda/

# Accidentally created directories
CUsersUser/

# Claude Code memory (local session data)
.claude/

# Snakemake-generated sentinel files
config/.ciriquant_ready

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# audit/: keep software/analysis provenance only; paper drafts, their extractions/figures and
# per-claim paper audits do not belong in this (public) repository
audit/*.docx
audit/paper*.txt
audit/figs/
audit/claims*
audit/extra_claims.txt
audit/audit_report.md
audit/summary.md
audit/unverifiable.md
# generated figures/tables are not tracked, only the scripts that produce them
audit/thesis_numbers/figs/
# per-claim paper audit and the tools that produce it
audit/verdicts_*.txt
audit/build_claims.py
audit/xref.json
# analysis input data for audit/thesis_numbers (the global data/ rule above would otherwise hide it)
!audit/thesis_numbers/data/
benchmark/partner_comparison.tsv
benchmark/er_sensitivity.tsv
benchmark/weight_sensitivity.tsv
benchmark/weight_sensitivity_summary.tsv
audit/table2_components_GSE133998.tsv
benchmark/component_stage1.tsv
audit/appendix_A1_parameters.tsv
audit/appendix_A2_per_dataset.tsv
audit/table7_dataset_basics.tsv
# analysis/: narrative write-ups cite unpublished thesis-§3.3 numbers and
# discuss submission-track conclusions -- pre-submission material, not
# tracked. The scripts that produce them (zero-computation, read-only
# reproducibility code) ARE tracked -- this is scoped to this directory's
# .md files only, not analysis/ as a whole, so scripts are never hidden.
analysis/*.md
